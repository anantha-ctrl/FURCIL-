# ── Security: block direct web access to secrets & internals ──
Options -Indexes
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|sql|md|example|ini|lock|json|sh|bat)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block web access to internal storage directory
    RewriteRule ^storage/ - [F,L]

    # Forward the Authorization header to PHP (CGI/FastCGI strip it otherwise)
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    # Route everything that isn't a real file/dir to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Fallback for mod_php setups
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
